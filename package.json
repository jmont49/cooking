{
  "name": "shua-personal-cooking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "workspaces": ["apps/*", "packages/*"],
  "overrides": {
    "vite": "8.2.0",
    "esbuild": "0.28.1"
  },
  "scripts": {
    "dev": "npm run dev -w @mise/web",
    "build": "npm run build -w @mise/domain && npm run build -w @mise/contracts && npm run build -w @mise/mcp && npm run build -w @mise/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "validate:openapi": "npx @redocly/cli lint docs/openapi.yaml",
    "mcp": "npm run start -w @mise/mcp"
  },
  "devDependencies": {
    "@eslint/js": "9.8.0",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.43.3",
    "@types/node": "22.19.0",
    "eslint": "9.8.0",
    "eslint-plugin-react-hooks": "5.1.0-rc.0",
    "globals": "15.9.0",
    "typescript": "5.5.4",
    "typescript-eslint": "8.0.1",
    "vitest": "4.1.10"
  }
}
