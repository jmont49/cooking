# Browser-safe configuration
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_DEMO_MODE=true
VITE_API_URL=http://127.0.0.1:54321/functions/v1/api

# Server-only Supabase Edge Function configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:5173
INTEGRATION_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# Optional AI. `mock` requires no external credentials.
AI_PROVIDER=mock
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_RECIPE_MODEL=gpt-4.1-mini
AI_FEEDBACK_MODEL=gpt-4.1-mini
AI_RECEIPT_MODEL=gpt-4.1-mini
AI_MONTHLY_SOFT_LIMIT_USD=5
AI_ENABLED=true
RECEIPT_SCANNING_ENABLED=false
